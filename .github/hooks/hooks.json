{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/adapter.sh preToolUse",
        "powershell": "bash .github/hooks/adapter.sh preToolUse",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/adapter.sh postToolUse",
        "powershell": "bash .github/hooks/adapter.sh postToolUse",
        "timeoutSec": 125
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/adapter.sh sessionStart",
        "powershell": "bash .github/hooks/adapter.sh sessionStart",
        "timeoutSec": 15
      }
    ]
  }
}
